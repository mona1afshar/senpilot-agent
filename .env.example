# Gmail account the agent monitors and sends from.
# Use a Google "App Password" (requires 2FA enabled on the account) --
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your-agent-account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# How often (seconds) the agent checks the inbox for new requests.
POLL_INTERVAL_SECONDS=30

# Max documents to download per request, per the assignment spec.
MAX_DOCS=10

# Run the browser headless (true) or visibly for debugging (false).
PLAYWRIGHT_HEADLESS=true
